{
  "name": "catalyst-ai",
  "description": "Build and operate Diagrid Catalyst by prompting: Dapr Workflows, Durable Agents, and the running system.",
  "version": "0.7.2",
  "author": {
    "name": "Diagrid",
    "url": "https://diagrid.io"
  },
  "homepage": "https://github.com/diagridio/catalyst-ai",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "commands": "./commands/",
  "mcpServers": {
    "catalyst": {
      "type": "http",
      "url": "${DIAGRID_MCP_URL:-https://mcp.cloud.r1.diagrid.io/mcp}",
      "headers": {
        "X-Catalyst-Plugin-Version": "0.7.2"
      },
      "oauth": {
        "clientId": "claude-code",
        "scopes": "catalyst:read catalyst:write offline_access"
      }
    }
  }
}
