# The Diagrid CLI release every command and flag in skills/ is verified against.
# TOML, read by scripts/diagrid_cli_pin.py.
#
# Why a file at the repo root rather than a field in .claude-plugin/plugin.json:
#
#   1. plugin.json is validated content. `claude plugin validate --strict` reads
#      it, and an unknown key in a manifest is exactly the class of thing this
#      repo's own linter refuses in SKILL.md frontmatter (ALLOWED_FRONTMATTER_KEYS).
#   2. plugin.json is *versioned* content. check_version_bump.py lists
#      `.claude-plugin/` in VERSIONED_PREFIXES, so pinning the CLI there would
#      force a plugin version bump — and therefore a new cache key pushed to
#      every installed user — for a change that alters nothing they receive.
#      The CLI pin is a CI input, not plugin content.
#
# Bumping this is the deliberate act that reruns the gate against a new CLI:
# change `version`, replace all four checksums, and expect the gate to fail on
# anything the new release moved. That failure is the point. Do not relax a
# check to make a bump green — fix the skill.
#
# Getting the checksums for a new version, one line per platform:
#
#   curl -sL "https://storage.googleapis.com/<bucket>/<version>/diagrid/diagrid_linux_amd64/diagrid_linux_amd64.tar.gz" | shasum -a 256
#
# The checksum, not the version string, is what makes the download trustworthy:
# `diagrid version` is printed by the very binary whose provenance is in
# question. This repo never pipes downloads.diagrid.io/cli/install.sh to a
# shell; it reads the same public GCS objects that script reads, and verifies
# them.

version = "v1.66.0"

# Public GCS bucket. Same default as install.sh, where it is the overridable
# GCP_BUCKET.
bucket = "bkt-p-cli-common-us-central1-95640"

# sha256 of
# https://storage.googleapis.com/<bucket>/<version>/diagrid/diagrid_<os>_<arch>/diagrid_<os>_<arch>.tar.gz
#
# All four platforms, not just the linux/amd64 one CI runs on: an unverified
# download on a maintainer's laptop is the same hole as an unverified download
# in CI, and the laptop is where a bump is prepared.
[sha256]
linux_amd64 = "9ffd12affbb2267805fb442a8d23948157a9d630ad49657bc5d2e9d9e6426e65"
linux_arm64 = "181ce15940d746b5baa5037132e3323d68cd15f87f0519009d60799558528b5a"
darwin_amd64 = "f0a4fd8114ca0f52c0fdfa30dbeda1a43323abfd5e52c1975e31270499632e0e"
darwin_arm64 = "875e085dc8e011c1e7d381941d73a4cccdc3d8b3fac3ebad0c9b78269e6b6b0b"

# Command paths whose very EXISTENCE the CLI reveals only to some logins.
#
# This is not the same as hidden. `appid` and `tokenbudget` are hidden — absent
# from `--help` and from the completion script — and still resolve for anyone, so
# the gate probes them and checks them fully. `managed-agent` is different:
# measured on the same pinned binary, same commit,
#
#   logged in as @diagrid.io   `diagrid managed-agent --help` prints its help
#   no login at all (CI)       cobra does not resolve it as a command
#
# So a gate that treated "cobra will not resolve it" as "does not exist" would
# report `diagrid managed-agent runs list` — which catalyst-debug documents and
# which works — as a nonexistent command on every pull request, while passing on
# the author's laptop. Someone would then "fix" a correct skill to get green.
#
# Listed here, the gate stops reporting the path as nonexistent and instead
# reports it as unverifiable in this environment, by name, with the CLI's own
# error. Where the path DOES resolve — any Diagrid developer's machine — nothing
# is suppressed and its flags and required flags are checked normally.
#
# The list is deliberately narrow and self-policing: an entry that turns out to
# be present in the completion script is a hard failure, because the CLI has
# stopped gating it and the entry is now hiding real coverage. Only the first
# token is matched, so `managed-agent bogus-verb` is still rejected wherever
# `managed-agent` resolves.
#
# Do not add to this to silence a failure. A command that does not resolve for
# anyone is a defect in the skill, which is the whole point of the gate.
[identity_gated]
managed-agent = "hidden unconditionally and gated on a @diagrid.io login; catalyst-agent-scaffold documents it precisely so a model recognises it rather than offering it"
